  "structures": [
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno (?:es|se trata) (?:solo|sólo|solamente|simplemente|únicamente) (?:de )?[^.!?\\n]{2,60}[,.;] (?:es|se trata de|sino)\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Decí la única cosa que querés decir. Borrá la mitad que prepara."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|que también)\\b",
      "name": "\"No solo X, sino también Y\"",
      "fix": "Partilo en dos frases o quedate con la mitad más fuerte."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\b(?:esto |eso )?no se trata de [^.!?\\n]{2,60}[.!] se trata de\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Arrancá por Y. El giro es la señal."
    },
    {
      "id": "el-resultado",
      "regex": "(?im)^\\s*¿?(?:el resultado|la clave|el secreto|lo mejor|la trampa|el truco|la respuesta|lo peor)\\?\\s*$",
      "name": "Línea de pregunta retórica de dos palabras",
      "fix": "Respondelo en la misma frase en vez de montar una revelación."
    },
    {
      "id": "esto-aprendi",
      "regex": "(?i)\\b(?:esto es lo que|te cuento lo que|les cuento lo que|esto fue lo que|lo que) (?:aprendí|aprendimos)\\b",
      "name": "\"Esto es lo que aprendí\"",
      "fix": "Decí la lección. Saltate el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b[^\\W\\d_]+, [^\\W\\d_]+ (?:y|e) [^\\W\\d_]+\\.",
      "name": "Tríada (regla de tres)",
      "fix": "Dos cosas o cuatro. Tres es el ritmo por defecto del modelo."
    },
    {
      "id": "cohete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de cohete / fuego / lamparita / brillos / diana",
      "fix": "Un emoji como mucho, y que no sea uno de estos cinco."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5 o más)",
      "fix": "Tres como máximo. El muro ya no suma alcance."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial|modelo de lenguaje)\\b",
      "name": "El modelo hablando de sí mismo",
      "fix": "Borrá la frase."
    },
    {
      "id": "en-resumen",
      "regex": "(?im)^\\s*(?:en resumen|en conclusión|en definitiva|para concluir|resumiendo|para cerrar)\\b",
      "name": "Cierre de ensayo",
      "fix": "Un post no necesita un párrafo de conclusión."
    },
    {
      "id": "cebo",
      "regex": "(?i)(?:¿\\s*)?(?:qué opinan|qué opinás|qué opinas|qué piensan|qué pensás|están de acuerdo|estás de acuerdo|me equivoco|quién más|alguien más)\\s*\\?\\s*$",
      "name": "Pregunta de enganche refleja",
      "fix": "Hacé una pregunta que solo vos podrías hacer, sobre lo concreto de arriba."
    },
    {
      "id": "no-scrollees",
      "regex": "(?im)^\\s*(?:dejá de scrollear|deja de scrollear|no sigas scrolleando|pará de scrollear|no hagas scroll|esper[aá],? no scrollees)\\b",
      "name": "Apertura \"dejá de scrollear\"",
      "fix": "El freno tiene que ser la afirmación misma. Pedir atención delata que no te la ganaste."
    },
    {
      "id": "preambulo",
      "regex": "(?i)\\b(?:en (?:este|el) (?:hilo|post|video)(?: de hoy)? te (?:voy a|vamos a)|hoy te voy a (?:mostrar|enseñar|contar)|te voy a (?:mostrar|enseñar) (?:cómo|como|paso a paso))\\b",
      "name": "Preámbulo (\"en este hilo te voy a mostrar\")",
      "fix": "Borralo y arrancá por lo que prometés."
    },
    {
      "id": "emoji-vinetas",
      "regex": "(?m)^[ \\t]*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨][^\\n]*\\n[ \\t]*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]",
      "name": "Lista con emojis como viñetas",
      "fix": "Usá un guion o un salto de línea. Dos líneas seguidas que arrancan con emoji es lo más de plantilla que puede tener un post."
    },
    {
      "id": "mayusculas",
      "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑ]{3,}\\b){2,}",
      "name": "Tres o más palabras gritadas seguidas",
      "fix": "Las mayúsculas son volumen, no resaltador. Una palabra, como mucho."
    },
    {
      "id": "cebo-seguir",
      "regex": "(?i)\\b(?:segu[ií]me para m[aá]s|s[ií]gueme para m[aá]s|etiquet[aá] a alguien|etiqueta a alguien|compart[ií] (?:esto|este hilo) si|comparte (?:esto|este hilo) si|coment[aá] abajo si|(?:dale )?(?:rt|retweet|repost|like) si)\\b",
      "name": "Pedido reflejo de follow, etiqueta o RT",
      "fix": "Pedí la única acción que este post se gana. El pedido genérico entrena a tu audiencia a ignorar todos los pedidos."
    },
    {
      "id": "hilo-como-gancho",
      "regex": "(?im)^\\s*(?:un\\s+)?(?:(?:mega|mini|breve|corto|largo)\\s+)?(?:hilo|thread)\\s*[:.]?\\s*(?:\\U0001F9F5|\\U0001F447|⬇️?|↓)*\\s*$|^\\s*\\U0001F9F5\\s*$",
      "name": "\"Un hilo\" como gancho",
      "fix": "\"Un hilo\" es una etiqueta, no un gancho. Poné lo que prometés en la línea 1 y dejá que X muestre que es un hilo."
    },
    {
      "id": "cierre-hilo",
      "regex": "(?i)\\bsi (?:este hilo |esto |este post )?te (?:sirvió|gustó|resultó útil|pareció útil)\\b",
      "name": "Cierre de hilo de manual",
      "fix": "El último post de un hilo es el que se captura. Usalo para el resumen o un solo próximo paso, no para el párrafo con el que terminan todos."
    }
  ]
}